generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum UserAccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum PermissionType {
  SCREEN
  API
  DATA
  MENU
}

enum WidgetType {
  CHART
  CARD
  TABLE
  TEXT
}

enum FormLayoutType {
  STACK
  GRID
  TABS
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum ControlType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  SELECT
  MULTI_SELECT
  CHECKBOX
  DATE
  FILE
}

enum ValidationRuleType {
  REQUIRED
  MIN
  MAX
  MIN_LENGTH
  MAX_LENGTH
  PATTERN
  EMAIL
  CUSTOM
}

enum GridColumnType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  ENUM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  VIEW
  EXPORT
  IMPORT
  OTHER
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  emailVerified   Boolean           @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean           @default(true)
  status          UserAccountStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailTokens         EmailVerificationToken[]
  memberships         OrganizationMember[]
  ownedOrganizations  Organization[]           @relation("OrgOwner")
  invitesSent         UserInvite[]             @relation("InviteSender")
  invitesReceived     UserInvite[]             @relation("InviteReceiver")
  formSubmissions     FormSubmission[]
  gridSavedViews      GridSavedView[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  pushDevices         PushDevice[]
  savedSearches       SavedSearch[]
  auditLogs           AuditLog[]
  activityEvents      ActivityEvent[]
  loginHistory        LoginHistory[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceName   String?
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  members       OrganizationMember[]
  branches      Branch[]
  departments   Department[]
  designations  Designation[]
  teams         Team[]
  costCenters   CostCenter[]
  passwordPolicy PasswordPolicy?
  invites       UserInvite[]
  iamRoles      IamRole[]
  permissions   Permission[]
  menuGroups    MenuGroup[]
  menus         Menu[]
  dashboards    Dashboard[]
  landingPages  LandingPage[]
  dynamicForms  DynamicForm[]
  dynamicGrids  DynamicGrid[]
  notifications Notification[]
  savedSearches SavedSearch[]
  auditLogs     AuditLog[]
  activityEvents ActivityEvent[]

  @@index([ownerId])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  teams        Team[]
  costCenters  CostCenter[]
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teams        Team[]
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@map("departments")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  level          Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  departmentId   String?
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("teams")
}

model CostCenter {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cost_centers")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole          @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  branchId       String?
  departmentId   String?
  designationId  String?
  teamId         String?
  costCenterId   String?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  memberRoles  MemberRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model UserInvite {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole   @default(MEMBER)
  tokenHash      String    @unique
  invitedById    String
  userId         String?
  branchId       String?
  departmentId   String?
  designationId  String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id])
  user         User?        @relation("InviteReceiver", fields: [userId], references: [id])

  @@index([organizationId, email])
  @@map("user_invites")
}

model PasswordPolicy {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  minLength          Int      @default(8)
  requireUppercase   Boolean  @default(true)
  requireLowercase   Boolean  @default(true)
  requireNumber      Boolean  @default(true)
  requireSpecialChar Boolean  @default(false)
  passwordHistory    Int      @default(0)
  maxAgeDays         Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("password_policies")
}

model Permission {
  id             String         @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  type           PermissionType
  resource       String?
  action         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  menus          Menu[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("permissions")
}

model IamRole {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  roleMenus       RoleMenu[]
  memberRoles     MemberRole[]
  dashboards      Dashboard[]
  landingPages    LandingPage[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("iam_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       IamRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  id         String @id @default(uuid())
  memberId   String
  roleId     String
  assignedAt DateTime @default(now())

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   IamRole            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@map("member_roles")
}

model MenuGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menus        Menu[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("menu_groups")
}

model Menu {
  id             String   @id @default(uuid())
  organizationId String
  groupId        String?
  parentId       String?
  label          String
  path           String?
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  permissionId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        MenuGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parent       Menu?        @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Menu[]       @relation("MenuTree")
  permission   Permission?  @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  roleMenus    RoleMenu[]

  @@index([organizationId])
  @@index([groupId])
  @@map("menus")
}

model RoleMenu {
  id     String @id @default(uuid())
  roleId String
  menuId String

  role IamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("role_menus")
}

model Dashboard {
  id             String   @id @default(uuid())
  organizationId String
  roleId         String?
  name           String
  slug           String
  description    String?
  isDefault      Boolean  @default(false)
  isLanding      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         IamRole?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  widgets      Widget[]
  landingPages LandingPage[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([roleId])
  @@map("dashboards")
}

model Widget {
  id          String     @id @default(uuid())
  dashboardId String
  type        WidgetType
  title       String
  config      Json       @default("{}")
  sortOrder   Int        @default(0)
  posX        Int        @default(0)
  posY        Int        @default(0)
  width       Int        @default(4)
  height      Int        @default(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("widgets")
}

model LandingPage {
  id             String   @id @default(uuid())
  organizationId String
  roleId         String
  dashboardId    String
  path           String   @default("/app")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         IamRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  dashboard    Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleId])
  @@index([organizationId])
  @@map("landing_pages")
}

model DynamicForm {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  layoutType     FormLayoutType @default(TABS)
  layoutConfig   Json           @default("{}")
  status         FormStatus     @default(DRAFT)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tabs         FormTab[]
  sections     FormSection[]
  submissions  FormSubmission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("dynamic_forms")
}

model FormTab {
  id        String   @id @default(uuid())
  formId    String
  name      String
  code      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form     DynamicForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  sections FormSection[]

  @@unique([formId, code])
  @@index([formId])
  @@map("form_tabs")
}

model FormSection {
  id          String   @id @default(uuid())
  formId      String
  tabId       String?
  name        String
  code        String
  columns     Int      @default(2)
  sortOrder   Int      @default(0)
  collapsible Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form     DynamicForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  tab      FormTab?      @relation(fields: [tabId], references: [id], onDelete: SetNull)
  controls FormControl[]

  @@unique([formId, code])
  @@index([formId])
  @@index([tabId])
  @@map("form_sections")
}

model FormControl {
  id           String      @id @default(uuid())
  sectionId    String
  fieldKey     String
  label        String
  controlType  ControlType @default(TEXT)
  placeholder  String?
  helpText     String?
  defaultValue String?
  options      Json        @default("[]")
  colSpan      Int         @default(1)
  sortOrder    Int         @default(0)
  required     Boolean     @default(false)
  isActive     Boolean     @default(true)
  config       Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  section     FormSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  validations FormValidation[]

  @@unique([sectionId, fieldKey])
  @@index([sectionId])
  @@map("form_controls")
}

model FormValidation {
  id        String             @id @default(uuid())
  controlId String
  ruleType  ValidationRuleType
  value     String?
  message   String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  control FormControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([controlId])
  @@map("form_validations")
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  submittedBy String?
  data        Json
  createdAt   DateTime @default(now())

  form DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [submittedBy], references: [id], onDelete: SetNull)

  @@index([formId])
  @@map("form_submissions")
}

model DynamicGrid {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  code            String
  description     String?
  pageSize        Int      @default(10)
  enableSort      Boolean  @default(true)
  enableFilter    Boolean  @default(true)
  enableExport    Boolean  @default(true)
  enableImport    Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  columns      GridColumn[]
  rows         GridRow[]
  savedViews   GridSavedView[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("dynamic_grids")
}

model GridColumn {
  id         String         @id @default(uuid())
  gridId     String
  fieldKey   String
  title      String
  dataType   GridColumnType @default(TEXT)
  sortable   Boolean        @default(true)
  filterable Boolean        @default(true)
  visible    Boolean        @default(true)
  width      Int?
  sortOrder  Int            @default(0)
  format     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  grid DynamicGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  @@unique([gridId, fieldKey])
  @@index([gridId])
  @@map("grid_columns")
}

model GridRow {
  id        String   @id @default(uuid())
  gridId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grid DynamicGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  @@index([gridId])
  @@map("grid_rows")
}

model GridSavedView {
  id        String   @id @default(uuid())
  gridId    String
  userId    String?
  name      String
  filters   Json     @default("[]")
  sorts     Json     @default("[]")
  columns   Json     @default("[]")
  isDefault Boolean  @default(false)
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grid DynamicGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gridId])
  @@index([userId])
  @@map("grid_saved_views")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String
  title          String
  body           String
  type           String   @default("INFO")
  link           String?
  data           Json     @default("{}")
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                      @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus  @default(PENDING)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime                    @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  emailEnabled   Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  inAppEnabled   Boolean  @default(true)
  mutedTypes     Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  token      String
  platform   String   @default("web")
  label      String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("push_devices")
}

model SavedSearch {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  query          String
  scope          String   @default("ALL")
  filters        Json     @default("{}")
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("saved_searches")
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  userId         String?
  action         AuditAction
  resource       String
  resourceId     String?
  summary        String?
  metadata       Json        @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resource])
  @@map("audit_logs")
}

model ActivityEvent {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  actorId        String?
  type           String
  title          String
  summary        String?
  link           String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_events")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  deviceName    String?
  failureReason String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}
