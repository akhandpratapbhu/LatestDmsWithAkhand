{
  "name": "fullcursor-dms",
  "version": "0.1.0",
  "private": true,
  "description": "Document Management System – monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @dms/api",
    "dev:web": "npm run dev -w @dms/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @dms/api",
    "build:web": "npm run build -w @dms/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "npm run prisma:generate -w @dms/api",
    "db:migrate": "npm run prisma:migrate -w @dms/api",
    "db:push": "npm run prisma:push -w @dms/api",
    "db:studio": "npm run prisma:studio -w @dms/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^7.0.2"
  }
}
