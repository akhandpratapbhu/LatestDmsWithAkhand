# Application
NODE_ENV=development
APP_NAME=configure-system
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PREFIX=api/v1
PORT=3000

# Database (PostgreSQL)
# Host localhost:5435 · user configure · password configure_secret · DB configure_system
DATABASE_URL=postgresql://configure:configure_secret@localhost:5435/configure_system?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth / OTP
OTP_EXPIRES_IN_SECONDS=300
OTP_LENGTH=6
MAX_LOGIN_DEVICES=5
BCRYPT_SALT_ROUNDS=12

# Email (console transport in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Configure System <noreply@configure.local>"
EMAIL_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=debug
